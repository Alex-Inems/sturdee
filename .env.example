# Required for the app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key — used server-side only (guest skill registration, Stripe
# webhooks, optional LiveKit attendance). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sturdee AI (tutor chat, practice coach, cohort matcher) ──────────────────
# Required for /ai, /api/ai/* (Pro subscribers only).
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# ── Sturdee Pro billing ($20/month via Stripe) ───────────────────────────────
# 1. Create a Product "Sturdee Pro" with a $20/month recurring Price in Stripe
# 2. Paste the Price ID below (or leave blank to auto-create in development)
# 3. Add webhook endpoint: {SITE}/api/billing/webhook
#    Events: checkout.session.completed, customer.subscription.*
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Google Meet classroom (primary) ──────────────────────────────────────────
# Paste Meet links when creating classes (email login — no Google OAuth required).

# ── LiveKit native classroom (optional / legacy) ─────────────────────────────
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Guest classroom sessions (no login). On by default in local development.
# ALLOW_CLASSROOM_GUEST=true
