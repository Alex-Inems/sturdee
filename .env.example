# Required for the app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Meet classroom (hosts)
# 1. Enable "Google Meet API" in Google Cloud Console
# 2. Add the Meet scope to your Supabase Google provider:
#    https://www.googleapis.com/auth/meetings.space.created
# 3. Hosts sign in via "Sign in with Google" on /classroom/host
#    (or paste a meet.google.com link when creating a class)
#
# Free Google Meet supports up to 100 participants per session.
